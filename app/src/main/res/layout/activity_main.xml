<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fff8f0"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Guideline for centering if needed, but we'll use chains -->

        <soup.neumorphism.NeumorphCardView
            android:id="@+id/titleContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:neumorph_backgroundColor="#FFF8F0"
            app:neumorph_shapeType="flat"
            app:neumorph_strokeWidth="0dp"
            app:neumorph_cornerFamily="rounded"
            app:neumorph_cornerSize="24dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/heroCard"
            app:layout_constraintVertical_chainStyle="spread">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:fontFamily="@font/libre_baskerville"
                android:text="BabyGuard"
                android:textColor="#333333"
                android:textSize="32sp"
                android:textStyle="bold|italic"/>

        </soup.neumorphism.NeumorphCardView>

        <soup.neumorphism.NeumorphCardView
            android:id="@+id/heroCard"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            app:neumorph_backgroundColor="#FFF8F0"
            app:neumorph_shapeType="flat"
            app:neumorph_strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@+id/titleContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/subtitleGroup">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="121dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    android:background="#DDDDDD"
                    android:scaleType="centerCrop"
                    android:src="@drawable/babyguarddashboard" />
            </androidx.cardview.widget.CardView>
        </soup.neumorphism.NeumorphCardView>

        <LinearLayout
            android:id="@+id/subtitleGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            app:layout_constraintTop_toBottomOf="@+id/heroCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/cardCameraMode">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hello! Let's set up your safe space"
                android:fontFamily="sans-serif"
                android:textStyle="italic"
                android:textSize="16sp"
                android:textColor="#333333"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Which device is this?"
                android:fontFamily="sans-serif"
                android:textSize="14sp"
                android:textColor="#7E57C2"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <soup.neumorphism.NeumorphCardView
            android:id="@+id/cardCameraMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:neumorph_backgroundColor="#b4d7ff"
            app:neumorph_shapeType="flat"
            app:neumorph_strokeWidth="0dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@+id/subtitleGroup"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/cardParentMode">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">

                <soup.neumorphism.NeumorphCardView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    app:neumorph_backgroundColor="#b4d7ff"
                    app:neumorph_shapeType="flat"
                    app:neumorph_strokeWidth="0dp"
                    app:neumorph_shadowElevation="6dp"
                    app:neumorph_shadowColorLight="#E3F2FF"
                    app:neumorph_shadowColorDark="#6FA0D8"
                    android:layout_marginBottom="10dp">
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#99AACC"
                            android:scaleType="centerCrop"
                            android:src="@drawable/babyunit" />
                    </androidx.cardview.widget.CardView>
                </soup.neumorphism.NeumorphCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Baby's Unit (Camera)"
                    android:fontFamily="sans-serif"
                    android:textColor="#A37BFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Place this device in the nursery"
                    android:fontFamily="sans-serif"
                    android:textColor="#7E57C2"
                    android:textSize="13sp"
                    android:textAlignment="center"/>
            </LinearLayout>
        </soup.neumorphism.NeumorphCardView>

        <soup.neumorphism.NeumorphCardView
            android:id="@+id/cardParentMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:neumorph_backgroundColor="#b4d7ff"
            app:neumorph_shapeType="flat"
            app:neumorph_strokeWidth="0dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toBottomOf="@+id/cardCameraMode"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/btnQuitApp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">

                <soup.neumorphism.NeumorphCardView
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    app:neumorph_backgroundColor="#b4d7ff"
                    app:neumorph_shapeType="flat"
                    app:neumorph_strokeWidth="0dp"
                    app:neumorph_shadowElevation="6dp"
                    app:neumorph_shadowColorLight="#E3F2FF"
                    app:neumorph_shadowColorDark="#6FA0D8"
                    android:layout_marginBottom="10dp">
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#99AACC"
                            android:scaleType="centerCrop"
                            android:src="@drawable/parentunit" />
                    </androidx.cardview.widget.CardView>
                </soup.neumorphism.NeumorphCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Parent's Unit (Monitor)"
                    android:fontFamily="sans-serif"
                    android:textColor="#A37BFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Keep this device with you"
                    android:fontFamily="sans-serif"
                    android:textColor="#7E57C2"
                    android:textSize="13sp"
                    android:textAlignment="center"/>
            </LinearLayout>
        </soup.neumorphism.NeumorphCardView>

        <TextView
            android:id="@+id/btnQuitApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif"
            android:padding="12dp"
            android:text="Quit App"
            android:textColor="#B05050"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardParentMode" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>